---
import '../styles/global.css';
const { title = 'suprlab — A place for things worth making.', description = 'Independent projects in software, hardware and sound. Built by slowphase.', article = false } = Astro.props;
const base=import.meta.env.BASE_URL;
---
<!doctype html><html lang="en-AU"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/><meta name="theme-color" content="#181818"/><link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml"/></head><body><a class="skip" href="#main">Skip to content</a><header class="site-header wrap"><a class="brand" href={base} aria-label="suprlab home">suprlab<span class="brand-underscore">_</span></a><nav aria-label="Main"><a href={`${base}#projects`}>Projects</a><a href={`${base}guides/`}>Guides</a><a href={`${base}about/`}>About</a><a class="github-nav" href="https://github.com/slowphase">GitHub <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .8a11.3 11.3 0 0 0-3.6 22c.6.1.8-.2.8-.5v-2.1c-3.3.7-4-1.4-4-1.4-.5-1.3-1.3-1.6-1.3-1.6-1.1-.8.1-.8.1-.8 1.2.1 1.8 1.2 1.8 1.2 1 1.7 2.6 1.2 3.3.9.1-.8.4-1.2.7-1.5-2.6-.3-5.3-1.3-5.3-5.6 0-1.2.4-2.2 1.2-3-.2-.3-.5-1.5.1-3 0 0 1-.3 3.1 1.1a10.8 10.8 0 0 1 5.7 0c2.1-1.4 3.1-1.1 3.1-1.1.6 1.5.3 2.7.1 3 .8.8 1.2 1.8 1.2 3 0 4.3-2.7 5.3-5.3 5.6.4.4.8 1.1.8 2.2v3.1c0 .3.2.6.8.5A11.3 11.3 0 0 0 12 .8Z"/></svg></a></nav></header><main id="main"><slot/></main><footer class="wrap"><a class="brand" href={base} aria-label="suprlab home">suprlab<span class="brand-underscore">_</span></a><p>A personal workshop by <a href="https://github.com/slowphase">slowphase</a>.</p><a href={`${base}about/`}>About this little corner of the internet</a></footer></body></html>
