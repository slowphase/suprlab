---
import Layout from '../../layouts/Layout.astro';
import posts from '../../data/posts.json';
const base=import.meta.env.BASE_URL;
---
<Layout title="dean — suprlab"><section class="wrap page-heading"><span class="eyebrow">SUPRLAB / AUTHOR</span><h1>dean</h1><p>Project journals from the suprlab workbench.</p></section><section class="wrap archive-list">{posts.filter(p=>p.type==='post').map(p=><article class="archive-entry"><div><h2><a href={`${base}${p.slug}/`}>{p.title}</a></h2><p>{p.excerpt}…</p></div></article>)}</section></Layout>
